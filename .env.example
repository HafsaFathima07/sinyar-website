PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sinyar_tracker
DATABASE_SSL=false
PG_IP_FAMILY=4
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_USERNAME=SALEEM
ADMIN_PASSWORD=replace-before-first-run
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads
COOKIE_SECURE=false
STORAGE_PROVIDER=local
PG_POOL_MAX=5
# Optional object storage adapter settings for production deployments:
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_KEY=