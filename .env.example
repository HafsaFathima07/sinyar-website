PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres
DATABASE_SSL=false
PG_IP_FAMILY=4
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_USERNAME=SALEEM
ADMIN_PASSWORD=replace-before-first-run
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=sinyar-files
PG_POOL_MAX=3